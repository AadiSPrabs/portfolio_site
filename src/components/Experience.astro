---
// One record per role or degree. `start`/`end` are ISO dates and drive both
// the year labels and the marker's position on the span axis.
const records = [
  {
    kind: 'Education',
    status: 'In progress',
    role: 'BTech Computer Science',
    org: 'Dayananda Sagar University',
    dept: 'Department of Computer Science & Engineering',
    mark: 'DSU',
    summary:
      'Coursework across data structures, algorithms, operating systems, and database management, with a focus on the systems side of the stack.',
    start: '2024-08-01',
    end: '2028-06-30',
  },
];

// The axis encodes where the degree actually is right now, so "In progress"
// is a position on a timeline rather than a badge. Computed at build time:
// the page is static, so a stale marker is a deploy question, not a bug.
const now = Date.now();
const recordsWithProgress = records.map((entry) => {
  const start = Date.parse(entry.start);
  const end = Date.parse(entry.end);
  const raw = ((now - start) / (end - start)) * 100;
  const progress = Math.min(100, Math.max(0, Number.isFinite(raw) ? raw : 0));
  return { ...entry, progress: Math.round(progress * 10) / 10 };
});
---

<section id="experience">
  <h2 class="section-title">Experience</h2>

  <ol class="exp-list" role="list">
    {recordsWithProgress.map((entry, i) => (
      <li class="exp-item glass-panel-card">
        <article class="exp-record">
          <header class="exp-meta">
            <span class="exp-label">
              <span class="exp-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="exp-sep" aria-hidden="true"></span>
              <span class="exp-kind">{entry.kind}</span>
            </span>
            <span class="exp-status">
              <span class="exp-status-dot" aria-hidden="true"></span>
              {entry.status}
            </span>
          </header>

          <h3 class="exp-role">{entry.role}</h3>

          <div class="exp-body">
            <div class="exp-org">
              <span class="exp-mark" aria-hidden="true">{entry.mark}</span>
              <div class="exp-org-text">
                <p class="exp-org-name">{entry.org}</p>
                <p class="exp-dept">{entry.dept}</p>
              </div>
            </div>

            <p class="exp-summary">{entry.summary}</p>
          </div>

          <p class="exp-span" style={`--progress: ${entry.progress}%`}>
            <time class="exp-year" datetime={entry.start.slice(0, 4)}>{entry.start.slice(0, 4)}</time>
            <span class="exp-track" aria-hidden="true">
              <span class="exp-fill"></span>
              <span class="exp-now"></span>
            </span>
            <time class="exp-year" datetime={entry.end.slice(0, 4)}>{entry.end.slice(0, 4)}</time>
          </p>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  #experience {
    --exp-rule: color-mix(in srgb, var(--text-main) 14%, transparent);
    --exp-axis: color-mix(in srgb, var(--text-main) 30%, transparent);
    --exp-seal: color-mix(in srgb, var(--text-main) 16%, transparent);
  }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The surface comes from .glass-panel-card; this element only owns the
     record's internal composition. */
  .exp-record {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }

  .exp-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block-end: 0.9rem;
    border-block-end: 1px solid var(--exp-rule);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .exp-label {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-inline-size: 0;
  }

  .exp-index {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--text-main);
  }

  .exp-sep {
    inline-size: clamp(1rem, 3vw, 2rem);
    block-size: 1px;
    background: var(--exp-rule);
    flex: none;
  }

  .exp-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
    /* Tracked caps carry a trailing gap; pull the label back to the edge. */
    margin-inline-end: -0.16em;
  }

  .exp-status-dot {
    flex: none;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 50%;
    background: var(--text-main);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--text-main) 12%, transparent);
  }

  .exp-role {
    margin-block: clamp(1rem, 2.4vw, 1.6rem) 0;
    font-family: 'Archivo', 'DM Sans', sans-serif;
    font-stretch: 112%;
    font-size: clamp(2.75rem, 5.6vw, 4.35rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--text-main);
    text-wrap: balance;
  }

  .exp-body {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: start;
    margin-block-start: clamp(1.5rem, 3.2vw, 2.4rem);
  }

  .exp-org {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-inline-size: 0;
  }

  /* A typographic seal instead of a pasted-on raster logo: it belongs to the
     monochrome system and stays crisp at any density. */
  .exp-mark {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--exp-seal);
    border-radius: 0.4rem;
    background: var(--panel-bg-subtle);
    font-family: 'Archivo', 'DM Sans', sans-serif;
    font-stretch: 112%;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--text-main);
    opacity: 0.82;
  }

  .exp-org-text {
    min-inline-size: 0;
  }

  .exp-org-name {
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-main);
  }

  .exp-dept {
    margin-block-start: 0.25rem;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .exp-summary {
    max-inline-size: 56ch;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* The span axis: 2024 and 2028 seated on a hairline, with the living end of
     the line marked by the same plus the background grid is built from. */
  .exp-span {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.35rem);
    margin-block-start: clamp(2rem, 4.5vw, 3.4rem);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .exp-year {
    transition: color 0.35s ease;
  }

  .exp-item:hover .exp-year {
    color: var(--text-main);
  }

  .exp-track {
    position: relative;
    block-size: 1px;
    background: var(--exp-axis);
  }

  /* End caps: the line reads as a measured span, not a rule that happened to
     stop before the year label. */
  .exp-track::before,
  .exp-track::after {
    content: "";
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    inline-size: 1px;
    block-size: 0.45rem;
    background: var(--exp-axis);
  }

  .exp-track::before {
    left: 0;
  }

  .exp-track::after {
    right: 0;
  }

  .exp-fill {
    position: absolute;
    inset: 0 auto 0 0;
    inline-size: var(--progress, 0%);
    background: var(--text-main);
    transform: scaleX(1);
    transform-origin: left center;
    transition: transform 1.3s var(--ease-out-quart) 0.1s;
  }

  .exp-now {
    position: absolute;
    top: 50%;
    left: var(--progress, 0%);
    translate: -50% -50%;
    inline-size: 0.72rem;
    block-size: 0.72rem;
    color: var(--text-main);
    opacity: 1;
    scale: 1;
    transition:
      opacity 0.5s ease 0.85s,
      scale 0.7s var(--ease-out-quart) 0.85s,
      rotate 0.45s var(--ease-out-quart);
  }

  .exp-now::before,
  .exp-now::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    background: currentColor;
    border-radius: 1px;
  }

  .exp-now::before {
    inline-size: 1.5px;
    block-size: 100%;
  }

  .exp-now::after {
    inline-size: 100%;
    block-size: 1.5px;
  }

  /* The axis only draws once the section has been seen. The default is the
     finished state, so with scripting off the record still shows its whole
     shape; the hidden class is what arms the animation. */
  #experience.section-hidden .exp-fill {
    transform: scaleX(0);
  }

  #experience.section-hidden .exp-now {
    opacity: 0;
    scale: 0.4;
  }

  #experience.section-visible .exp-fill {
    transform: scaleX(1);
  }

  #experience.section-visible .exp-now {
    opacity: 1;
    scale: 1;
  }

  .exp-item:hover .exp-now {
    rotate: 45deg;
  }

  @media (max-width: 60rem) {
    .exp-body {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.25rem, 4vw, 1.75rem);
    }

    .exp-summary {
      max-inline-size: 62ch;
    }
  }

  @media (max-width: 40rem) {
    .exp-meta {
      font-size: 0.66rem;
      letter-spacing: 0.12em;
    }

    .exp-role {
      margin-block-start: 0.9rem;
      font-size: clamp(2rem, 9.5vw, 2.75rem);
    }

    .exp-mark {
      inline-size: 2.35rem;
      block-size: 2.35rem;
    }

    .exp-org-name {
      font-size: 0.98rem;
    }

    .exp-span {
      margin-block-start: 2rem;
      font-size: 0.72rem;
      gap: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-fill,
    .exp-now {
      transition-duration: 0.01ms;
      transition-delay: 0s;
    }

    .exp-fill {
      transform: scaleX(1);
    }

    .exp-now {
      opacity: 1;
      scale: 1;
    }
  }
</style>
